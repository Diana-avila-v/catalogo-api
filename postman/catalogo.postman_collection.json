      "item": [
        {
          "name": "Listar productos (sin token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const j = pm.response.json();",
                  "pm.test(\"data es un arreglo con al menos 5 productos\", () => {",
                  "  pm.expect(j.data).to.be.an(\"array\");",
                  "  pm.expect(j.data.length).to.be.at.least(5);",
                  "});",
                  "pm.test(\"Cada producto tiene los campos del modelo\", () => {",
                  "  j.data.forEach(p => pm.expect(p).to.include.keys(\"id\",\"nombre\",\"descripcion\",\"categoria\",\"precio\"));",
                  "});",
                  "pm.environment.set(\"idProductoExistente\", j.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            }
          }
        },
        {
