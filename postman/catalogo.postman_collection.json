    {
      "name": "05 Persistencia (reiniciar servidor)",
      "description": "Ejecuta la petición 1, detén el servidor (Ctrl+C), vuelve a iniciarlo con npm start y ejecuta la petición 2.",
      "item": [
        {
          "name": "1. Crear producto de persistencia",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "pm.environment.set(\"idPersistencia\", pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto Persistencia\",\n  \"descripcion\": \"Creado antes de reiniciar el servidor\",\n  \"categoria\": \"pruebas\",\n  \"precio\": 1.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. Consultar después de reiniciar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"El producto sigue guardado tras reiniciar Node.js\", () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.data.id).to.eql(pm.environment.get(\"idPersistencia\"));",
                  "  pm.expect(j.data.nombre).to.eql(\"Producto Persistencia\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{idPersistencia}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "{{idPersistencia}}"
              ]
            }
          }
        }
      ]
    }
