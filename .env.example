# Copia este archivo como .env y coloca tus propios valores. NUNCA subas el .env al repositorio.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/catalogo

# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=1h

# Datos del administrador que crea "npm run crear-admin"
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@catalogo.test
ADMIN_PASSWORD=cambia_esta_clave
